{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wana-dashboard",
  "compatibility_date": "2026-05-02",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // SYSTEM_CONFIG KV id is synced from apps/worker — run `pnpm provision:system-config-kv` once
  "kv_namespaces": [
    {
      "binding": "SYSTEM_CONFIG",
      "id": "10923c906f13434f8a573b15d5f5adcc"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB_CONTROL",
      "database_name": "wana-control-plane",
      "database_id": "22092b33-3345-4efe-b9d3-298ba9c47bb0",
      "migrations_dir": "../../packages/schema/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PAYLOAD_STORAGE",
      "bucket_name": "wana-payloads"
    }
  ],
  // Pages does NOT inherit bindings into per-environment overrides — declaring
  // an `env.production` block would silently drop KV/D1/R2/DO bindings and 500.
  // So these stay as top-level production values; local dev overrides them via
  // `.dev.vars` or the `--var` flag in the preview-stack script.
  "vars": {
    "INGEST_PUBLIC_URL": "https://ingest.wana.shakenokiri.me",
    // Shown on /settings/tokens after issuing a PAT. Workers.dev fallback —
    // no DNS edit permission on the shakenokiri.me zone from this token, so
    // mcp.wana.shakenokiri.me isn't attached yet. Swap to the custom domain
    // once it's added manually (see apps/mcp/README.md → Deploy).
    "MCP_PUBLIC_URL": "https://wana-mcp.shakenokirimi12.workers.dev",
    "DASHBOARD_USER_ID": "",
    "DASHBOARD_DEV_FALLBACK": "false",
    "MAIL_FROM": "noreply@example.com",
    "WEBAUTHN_RP_NAME": "Wana",
    "WEBAUTHN_RP_ID": "wana.shakenokiri.me",
    "WEBAUTHN_ORIGIN": "https://wana.shakenokiri.me",
    // Off in production: passkey enrollment goes through invite tokens or the
    // authed-self path (a logged-in user adding a passkey to their own
    // account). Open email-only enrollment was a one-off for the
    // brand-domain migration.
    "WEBAUTHN_ALLOW_EMAIL_ENROLLMENT": "false",
    "ALLOW_OPEN_SIGNUP": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_DO",
        "class_name": "ProjectDataStore",
        "script_name": "wana-worker"
      },
      {
        "name": "SYMBOLICATOR",
        "class_name": "Symbolicator",
        "script_name": "wana-worker"
      }
    ]
  },
  // NOTE: Cloudflare Pages configuration does not accept `send_email` —
  // only standalone Workers can bind SEND_MAIL. Mail traffic from the
  // dashboard (e.g. invite emails) goes through the MAIL_SERVICE binding,
  // which fetches /__internal/send-mail on wana-worker (authenticated by
  // a shared INTERNAL_RPC_SECRET secret on both sides).
  "services": [
    { "binding": "MAIL_SERVICE", "service": "wana-worker" }
  ]
}
