{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wana-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	// Rules for importing SQL files
	"rules": [
		{
			"type": "Text",
			"globs": [
				"**/*.sql"
			],
			"fallthrough": true
		}
	],
	// KV for system config (maintenance mode). Before first deploy, run from repo root:
	//   pnpm provision:system-config-kv
	"kv_namespaces": [
		{
			"binding": "SYSTEM_CONFIG",
			"id": "10923c906f13434f8a573b15d5f5adcc"
		}
	],
	// R2 for storing full error payloads
	"r2_buckets": [
		{
			"binding": "PAYLOAD_STORAGE",
			"bucket_name": "wana-payloads"
		}
	],
	// Control-plane D1 — needed by the notifications dispatcher so the DO can
	// read endpoint/rule rows when an issue is created.
	"d1_databases": [
		{
			"binding": "DB_CONTROL",
			"database_name": "wana-control-plane",
			"database_id": "22092b33-3345-4efe-b9d3-298ba9c47bb0",
			"migrations_dir": "../../packages/schema/migrations"
		}
	],
	"vars": {
		"DASHBOARD_PUBLIC_URL": "https://wana.shakenokiri.me",
		"MAIL_FROM": "wana@shakenokiri.me"
	},
	// Cloudflare Email Sending binding for email notifications.
	// `shakenokiri.me` is verified at the account level, so SEND_MAIL can
	// emit from any address on the domain. No per-binding destination cap
	// — endpoints decide their own recipients; SSRF-style guardrails for
	// arbitrary recipients are not needed because the org has to enable the
	// email channel via the per-org features flag before any rule can fire.
	"send_email": [
		{ "name": "SEND_MAIL" }
	],
	// Queue consumers — main + DLQ.
	// Audit BUG-3: previously the DLQ had no consumer wired up, so poison
	// messages accumulated forever and the R2 payloads written before the
	// failed DO call were never cleaned up. The DLQ consumer below deletes
	// the R2 object and logs once.
	"queues": {
		"consumers": [
			{
				"queue": "wana-error-queue",
				"max_batch_size": 100,
				"max_batch_timeout": 5,
				// Cap retries and route poison messages to a dead-letter queue
				// instead of retrying forever. Create it once with:
				//   wrangler queues create wana-error-dlq
				"max_retries": 5,
				"dead_letter_queue": "wana-error-dlq"
			},
			{
				"queue": "wana-error-dlq",
				"max_batch_size": 20,
				"max_batch_timeout": 30,
				// One pass only — if R2 cleanup itself fails we ack anyway so
				// the message doesn't bounce forever; we just log.
				"max_retries": 0
			}
		]
	},
	// Durable Objects for per-project data storage. Containers are also
	// DOs under the hood, so the Symbolicator goes here too.
	"durable_objects": {
		"bindings": [
			{
				"name": "PROJECT_DO",
				"class_name": "ProjectDataStore"
			},
			{
				"name": "SYMBOLICATOR",
				"class_name": "Symbolicator"
			}
		]
	},
	// Workers Containers: a Linux container that wraps `llvm-symbolizer`
	// for dSYM-based stack-trace resolution. `basic` instance is enough
	// for typical mobile dSYMs (the largest we see in practice are a few
	// hundred MB and fit comfortably under the 4 GB ephemeral disk).
	"containers": [
		{
			"class_name": "Symbolicator",
			"image": "../symbolicator/Dockerfile",
			"instance_type": "basic",
			"max_instances": 5
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"ProjectDataStore"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"Symbolicator"
			]
		}
	]
}