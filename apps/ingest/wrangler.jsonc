{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wana-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // KV for system config — id is synced from apps/worker via `pnpm provision:system-config-kv`
  "kv_namespaces": [
    {
      "binding": "SYSTEM_CONFIG",
      "id": "10923c906f13434f8a573b15d5f5adcc"
    }
  ],
  // D1 for control plane data
  "d1_databases": [
    {
      "binding": "DB_CONTROL",
      "database_name": "wana-control-plane",
      "database_id": "22092b33-3345-4efe-b9d3-298ba9c47bb0",
      "migrations_dir": "../../packages/schema/migrations"
    }
  ],
  // Queue producer for error ingestion
  "queues": {
    "producers": [
      {
        "binding": "ERROR_QUEUE",
        "queue": "wana-error-queue"
      }
    ]
  },
  // Per-project ingest rate limit (Workers Rate Limiting). 600 events / 60s per
  // project; tune to your plan. Code enforces it only when the binding exists.
  "unsafe": {
    "bindings": [
      {
        "name": "INGEST_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 600, "period": 60 }
      },
      {
        "name": "INGEST_IP_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 1200, "period": 60 }
      }
    ]
  }
}
